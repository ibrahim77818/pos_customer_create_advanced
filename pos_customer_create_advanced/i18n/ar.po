msgid "Technical field: name given to a customer created from the Point of Sale without a name (shown as a hint in the customer form opened from the POS)."
msgstr "حقل تقني: الاسم الذي يُعطى لعميل يتم إنشاؤه من نقطة البيع دون اسم (يظهر كتلميح في نموذج العميل المفتوح من نقطة البيع)."

#. module: pos_customer_create_advanced
#: model:ir.model.fields,help:pos_customer_create_advanced.field_res_config_settings__pos_phonenumbers_missing
msgid "Technical: the 'phonenumbers' Python library is not installed on the server."
msgstr "حقل تقني: مكتبة بايثون 'phonenumbers' غير مثبتة على الخادم."

#. module: pos_customer_create_advanced
#: model_terms:ir.ui.view,arch_db:pos_customer_create_advanced.res_config_settings_view_form
msgid "The \"phonenumbers\" Python library is not installed on the server: numbers are saved as typed. Install it with \"pip install phonenumbers\" and restart Odoo."
msgstr "مكتبة بايثون \"phonenumbers\" غير مثبتة على الخادم: تُحفظ الأرقام كما أُدخلت. ثبّتها باستخدام \"pip install phonenumbers\" ثم أعد تشغيل Odoo."

#. module: pos_customer_create_advanced
#: model:ir.model.fields,help:pos_customer_create_advanced.field_pos_config__default_customer_name_enabled model:ir.model.fields,help:pos_customer_create_advanced.field_res_config_settings__pos_default_customer_name_enabled
msgid "When a cashier creates a customer from this Point of Sale with a phone number but leaves the name empty, the customer is saved under the default name below instead of being rejected."
msgstr "عندما ينشئ الكاشير عميلًا من نقطة البيع هذه برقم هاتف ويترك الاسم فارغًا، يتم حفظ العميل بالاسم الافتراضي أدناه بدلًا من رفضه."

#. module: pos_customer_create_advanced
#: model_terms:ir.ui.view,arch_db:pos_customer_create_advanced.res_config_settings_view_form
msgid "e.g. Walk-in Customer"
msgstr "مثال: عميل نقدي"
