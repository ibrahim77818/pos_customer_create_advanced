#. module: pos_customer_create_advanced
#: model_terms:ir.ui.view,arch_db:pos_customer_create_advanced.res_config_settings_view_form
msgid "Save phone numbers with the country code (0500477818 becomes +966500477818), ready for SMS and WhatsApp. Uses the customer's country, or the company's."
msgstr "احفظ أرقام الهاتف مع رمز الدولة (يصبح 0500477818 هو +966500477818)، جاهزة للرسائل النصية وواتساب. تُستخدم دولة العميل أو دولة الشركة."

