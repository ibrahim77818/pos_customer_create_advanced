<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_customer_create_advanced</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="after">
                <block title="Customer Onboarding" id="pos_customer_create_advanced_section">
                    <setting id="pos_default_customer_name_setting"
                             help="Customers created from this POS with a phone number but no name are saved under this name.">
                        <field name="pos_default_customer_name_enabled"/>
                        <div class="content-group mt16" invisible="not pos_default_customer_name_enabled">
                            <div class="row">
                                <label for="pos_default_customer_name" string="Name" class="col-lg-3 o_light_label"/>
                                <field name="pos_default_customer_name"
                                       placeholder="e.g. Walk-in Customer"
                                       required="pos_default_customer_name_enabled"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="pos_phone_e164_setting"
                             help="Save phone numbers with the country code (0500477818 becomes +966500477818), ready for SMS and WhatsApp. Uses the customer's country, or the company's.">
                        <field name="pos_phone_e164_enabled"/>
                        <field name="pos_phonenumbers_missing" invisible="1"/>
                        <div class="alert alert-warning mt8 mb-0" role="alert"
                             invisible="not pos_phone_e164_enabled or not pos_phonenumbers_missing">
                            The "phonenumbers" Python library is not installed on the server: numbers are saved as typed. Install it with "pip install phonenumbers" and restart Odoo.
                        </div>
                    </setting>
                    <setting id="pos_phone_substring_search_info" string="Flexible Phone Search"
                             help="Always active: typing any part of a phone or mobile number (e.g. &quot;456&quot;) finds the customer, whatever the number formatting."/>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
